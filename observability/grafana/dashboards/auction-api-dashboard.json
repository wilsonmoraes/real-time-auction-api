{
  "id": null,
  "uid": "auction-api",
  "title": "Auction API",
  "tags": ["auction", "take-home"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Bid accepted rate (per second)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(auction_bids_accepted_total[1m])",
          "legendFormat": "accepted"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Bid rejected rate by reason (per second)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(auction_bids_rejected_total[1m]))",
          "legendFormat": "{{reason}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "right" }
      }
    },
    {
      "type": "timeseries",
      "title": "HTTP latency p95 by route (5m window)",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 9 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket[5m])))",
          "legendFormat": "{{uri}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "HTTP latency avg by route (5m window)",
      "gridPos": { "x": 0, "y": 17, "w": 24, "h": 9 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (uri) (rate(http_server_requests_seconds_sum[5m])) / sum by (uri) (rate(http_server_requests_seconds_count[5m]))",
          "legendFormat": "{{uri}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    }
  ]
}

